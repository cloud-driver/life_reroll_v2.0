[
  {
    "id": "A01",
    "group": "帳號",
    "method": "POST",
    "path": "/api/v1/auth/register",
    "description": "註冊帳號",
    "input": "RegisterInput",
    "output": "201 User",
    "allowed": "匿名",
    "errors": "EMAIL_UNAVAILABLE,VALIDATION_ERROR",
    "rule": "建立後寄驗證信，不自動開始遊戲；同一冪等鍵不重寄。"
  },
  {
    "id": "A02",
    "group": "帳號",
    "method": "POST",
    "path": "/api/v1/auth/login",
    "description": "登入",
    "input": "LoginInput",
    "output": "200 Session",
    "allowed": "匿名",
    "errors": "INVALID_CREDENTIALS,RATE_LIMITED",
    "rule": "成功輪替 cookie 與 CSRF；錯誤不區分信箱不存在或密碼錯。"
  },
  {
    "id": "A03",
    "group": "帳號",
    "method": "GET",
    "path": "/api/v1/auth/session",
    "description": "查詢登入與取得 CSRF",
    "input": "—",
    "output": "200 Session",
    "allowed": "匿名或本人",
    "errors": "—",
    "rule": "無登入回 user=null；Cookie HttpOnly，前端不讀取。"
  },
  {
    "id": "A04",
    "group": "帳號",
    "method": "POST",
    "path": "/api/v1/auth/logout",
    "description": "登出目前裝置",
    "input": "—",
    "output": "204 —",
    "allowed": "本人",
    "errors": "—",
    "rule": "撤銷目前 cookie；不放棄遊戲。"
  },
  {
    "id": "A05",
    "group": "帳號",
    "method": "POST",
    "path": "/api/v1/auth/email-verification-requests",
    "description": "重新寄驗證信",
    "input": "EmailInput",
    "output": "202 Acknowledged",
    "allowed": "本人；匿名僅通用回覆",
    "errors": "EMAIL_COOLDOWN、EMAIL_RATE_LIMITED、MAIL_BUSY、MAIL_NOT_CONFIGURED",
    "rule": "僅登入本人帳號可實際重寄；匿名或不適用信箱一律通用回覆。冷卻 60 秒，失敗可重試。"
  },
  {
    "id": "A06",
    "group": "帳號",
    "method": "POST",
    "path": "/api/v1/auth/email-verifications",
    "description": "完成信箱驗證",
    "input": "TokenInput",
    "output": "200 Acknowledged",
    "allowed": "本人",
    "errors": "UNAUTHENTICATED、CSRF_INVALID、INVALID_VERIFICATION_CODE、VERIFICATION_CODE_EXPIRED、VERIFICATION_ATTEMPTS_EXCEEDED",
    "rule": "需登入本人帳號；六位數驗證碼十分鐘內有效，最多五次錯誤，重寄後舊碼失效。"
  },
  {
    "id": "A07",
    "group": "帳號",
    "method": "POST",
    "path": "/api/v1/auth/password-reset-requests",
    "description": "要求重設密碼",
    "input": "EmailInput",
    "output": "202 Acknowledged",
    "allowed": "匿名",
    "errors": "RATE_LIMITED",
    "rule": "一律一般確認；token 有效 30 分鐘。"
  },
  {
    "id": "A08",
    "group": "帳號",
    "method": "POST",
    "path": "/api/v1/auth/password-resets",
    "description": "完成密碼重設",
    "input": "ResetInput",
    "output": "200 Acknowledged",
    "allowed": "匿名",
    "errors": "TOKEN_INVALID_OR_EXPIRED",
    "rule": "撤銷所有登入，使用者重新登入。"
  },
  {
    "id": "A09",
    "group": "帳號",
    "method": "PUT",
    "path": "/api/v1/me/password",
    "description": "變更密碼",
    "input": "PasswordInput",
    "output": "200 Acknowledged",
    "allowed": "本人",
    "errors": "INVALID_CREDENTIALS",
    "rule": "成功撤銷全部登入，含目前裝置。"
  },
  {
    "id": "A10",
    "group": "帳號",
    "method": "GET",
    "path": "/api/v1/me",
    "description": "帳號資料",
    "input": "—",
    "output": "200 User",
    "allowed": "本人",
    "errors": "—",
    "rule": "不得混入遊戲角色病史。"
  },
  {
    "id": "A11",
    "group": "帳號",
    "method": "PATCH",
    "path": "/api/v1/me",
    "description": "更新暱稱",
    "input": "ProfileInput",
    "output": "200 User",
    "allowed": "本人",
    "errors": "VALIDATION_ERROR",
    "rule": "不可修改人設或遊戲數值。"
  },
  {
    "id": "A12",
    "group": "帳號",
    "method": "GET",
    "path": "/api/v1/me/sessions",
    "description": "裝置登入清單",
    "input": "—",
    "output": "200 Page<DeviceSession>",
    "allowed": "本人",
    "errors": "—",
    "rule": "只顯示本人裝置；不暴露完整 IP。"
  },
  {
    "id": "A13",
    "group": "帳號",
    "method": "DELETE",
    "path": "/api/v1/me/sessions/{session_id}",
    "description": "撤銷指定登入",
    "input": "—",
    "output": "204 —",
    "allowed": "本人",
    "errors": "NOT_FOUND",
    "rule": "若是目前裝置，導回登入頁。"
  },
  {
    "id": "A14",
    "group": "帳號",
    "method": "GET",
    "path": "/api/v1/me/settings",
    "description": "讀取偏好",
    "input": "—",
    "output": "200 Settings",
    "allowed": "本人",
    "errors": "—",
    "rule": "首次回預設值。"
  },
  {
    "id": "A15",
    "group": "帳號",
    "method": "PUT",
    "path": "/api/v1/me/settings",
    "description": "儲存偏好與新手教學完成",
    "input": "SettingsPatch",
    "output": "200 Settings",
    "allowed": "本人",
    "errors": "VALIDATION_ERROR",
    "rule": "完整替換偏好；不改 Run.version。"
  },
  {
    "id": "A16",
    "group": "帳號",
    "method": "POST",
    "path": "/api/v1/me/deletion-requests",
    "description": "請求刪除帳號資料",
    "input": "DeleteAccountInput",
    "output": "202 DeletionReceipt",
    "allowed": "本人",
    "errors": "INVALID_CREDENTIALS",
    "rule": "重新驗證密碼後立即撤銷登入；不是另開存檔入口；保留策略需上線前落實。"
  },
  {
    "id": "B01",
    "group": "內容與地圖",
    "method": "GET",
    "path": "/api/v1/bootstrap",
    "description": "服務版本與首頁設定",
    "input": "—",
    "output": "200 Bootstrap",
    "allowed": "公開",
    "errors": "—",
    "rule": "可快取；前端使用 terms_version 與 privacy_version。"
  },
  {
    "id": "B02",
    "group": "內容與地圖",
    "method": "GET",
    "path": "/api/v1/content/scenes",
    "description": "地圖與場景入口",
    "input": "query: content_version",
    "output": "200 Scene[]",
    "allowed": "本人",
    "errors": "CONTENT_VERSION_NOT_FOUND",
    "rule": "使用 Campaign 的內容版本；不可偷換最新地圖。"
  },
  {
    "id": "B03",
    "group": "內容與地圖",
    "method": "GET",
    "path": "/api/v1/content/lessons",
    "description": "短教學清單",
    "input": "query: content_version,topic?",
    "output": "200 Page<Lesson>",
    "allowed": "本人",
    "errors": "CONTENT_VERSION_NOT_FOUND",
    "rule": "基本說明先呈現，詳細段落可展開。"
  },
  {
    "id": "B04",
    "group": "內容與地圖",
    "method": "GET",
    "path": "/api/v1/content/lessons/{lesson_id}",
    "description": "教學詳細",
    "input": "query: content_version",
    "output": "200 Lesson",
    "allowed": "本人",
    "errors": "NOT_FOUND",
    "rule": "來源連結僅允許已審查的官方網址。"
  },
  {
    "id": "B05",
    "group": "內容與地圖",
    "method": "POST",
    "path": "/api/v1/me/lesson-reads/{lesson_id}",
    "description": "記錄已看教學",
    "input": "—",
    "output": "200 Acknowledged",
    "allowed": "本人",
    "errors": "NOT_FOUND",
    "rule": "同人同主題冪等；不加遊戲分數，不阻擋主要流程。"
  },
  {
    "id": "B06",
    "group": "內容與地圖",
    "method": "GET",
    "path": "/api/v1/me/notices",
    "description": "提醒清單",
    "input": "query: unread_only?",
    "output": "200 Page<Notice>",
    "allowed": "本人",
    "errors": "—",
    "rule": "報告完成或系統提醒；非事件處理佇列。"
  },
  {
    "id": "B07",
    "group": "內容與地圖",
    "method": "POST",
    "path": "/api/v1/me/notices/{notice_id}/read",
    "description": "標示提醒已讀",
    "input": "—",
    "output": "200 Acknowledged",
    "allowed": "本人",
    "errors": "NOT_FOUND",
    "rule": "已讀重複呼叫無副作用。"
  },
  {
    "id": "B08",
    "group": "內容與地圖",
    "method": "GET",
    "path": "/api/v1/content/legal/{kind}",
    "description": "註冊條款與隱私說明",
    "input": "query: version",
    "output": "200 LegalDocument",
    "allowed": "公開",
    "errors": "NOT_FOUND",
    "rule": "kind 路徑值 TERMS 或 PRIVACY；版本取 B01。"
  },
  {
    "id": "C01",
    "group": "遊戲與存檔",
    "method": "POST",
    "path": "/api/v1/campaigns",
    "description": "開始全新一場",
    "input": "CreateCampaignInput",
    "output": "202 AsyncReceipt",
    "allowed": "已驗證本人且無未完成 Campaign",
    "errors": "ACTIVE_CAMPAIGN_EXISTS,MAINTENANCE",
    "rule": "原子保留唯一 active 槽，固定人設與種子後排生成；失敗重試不重抽。"
  },
  {
    "id": "C02",
    "group": "遊戲與存檔",
    "method": "GET",
    "path": "/api/v1/campaigns/active",
    "description": "找回目前進度",
    "input": "—",
    "output": "200 Campaign?",
    "allowed": "本人",
    "errors": "—",
    "rule": "無進行中遊戲回 data=null；COMPLETED 不佔用 active 槽。"
  },
  {
    "id": "C03",
    "group": "遊戲與存檔",
    "method": "GET",
    "path": "/api/v1/campaigns",
    "description": "歷史遊戲清單",
    "input": "query: status?",
    "output": "200 Page<Campaign>",
    "allowed": "本人",
    "errors": "—",
    "rule": "最新建立優先；只能讀舊紀錄。"
  },
  {
    "id": "C04",
    "group": "遊戲與存檔",
    "method": "GET",
    "path": "/api/v1/campaigns/{campaign_id}",
    "description": "整場狀態",
    "input": "—",
    "output": "200 Campaign",
    "allowed": "擁有者",
    "errors": "NOT_FOUND",
    "rule": "回目前輪與 job；不回私有人生計畫。"
  },
  {
    "id": "C05",
    "group": "遊戲與存檔",
    "method": "GET",
    "path": "/api/v1/campaigns/{campaign_id}/runs",
    "description": "三輪人生索引",
    "input": "—",
    "output": "200 RunState[]",
    "allowed": "擁有者",
    "errors": "NOT_FOUND",
    "rule": "最多三筆；已結束輪只讀。"
  },
  {
    "id": "C06",
    "group": "遊戲與存檔",
    "method": "GET",
    "path": "/api/v1/runs/{run_id}",
    "description": "恢復權威快照",
    "input": "—",
    "output": "200 RunState",
    "allowed": "擁有者",
    "errors": "NOT_FOUND",
    "rule": "重新整理 雙分頁衝突或斷線後優先呼叫。"
  },
  {
    "id": "C07",
    "group": "遊戲與存檔",
    "method": "POST",
    "path": "/api/v1/runs/{run_id}/initial-allocation/complete",
    "description": "完成初次配置",
    "input": "VersionInput",
    "output": "200 MutationReceipt",
    "allowed": "INITIAL_ALLOCATION",
    "errors": "STATE_CONFLICT,STALE_VERSION",
    "rule": "允許資金全部留現金；前端先顯示風險摘要供玩家確認，不強迫買商品。轉 EXPLORING。"
  },
  {
    "id": "C08",
    "group": "遊戲與存檔",
    "method": "POST",
    "path": "/api/v1/runs/{run_id}/scene-transitions",
    "description": "進出建築",
    "input": "SceneInput",
    "output": "200 MutationReceipt",
    "allowed": "INITIAL_ALLOCATION 或 EXPLORING",
    "errors": "SCENE_NOT_REACHABLE,STATE_CONFLICT",
    "rule": "驗證連通與入口；只存場景，不傳每幀座標。"
  },
  {
    "id": "C09",
    "group": "遊戲與存檔",
    "method": "PATCH",
    "path": "/api/v1/runs/{run_id}/lifestyle",
    "description": "調整生活方案",
    "input": "LifestyleInput",
    "output": "200 MutationReceipt",
    "allowed": "INITIAL_ALLOCATION 或 EXPLORING 且在 HOME",
    "errors": "ACTION_NOT_ALLOWED",
    "rule": "下月起生效；生活品質反映長期選擇。"
  },
  {
    "id": "C10",
    "group": "遊戲與存檔",
    "method": "POST",
    "path": "/api/v1/runs/{run_id}/save",
    "description": "手動儲存",
    "input": "—",
    "output": "200 SaveReceipt",
    "allowed": "擁有者 任一狀態",
    "errors": "NOT_FOUND",
    "rule": "不接受資產 payload；讀寫鎖內儲存最新已提交版本，不建立可回溯存檔槽。"
  },
  {
    "id": "C11",
    "group": "遊戲與存檔",
    "method": "GET",
    "path": "/api/v1/runs/{run_id}/save",
    "description": "最新存檔資訊",
    "input": "—",
    "output": "200 SaveReceipt",
    "allowed": "擁有者",
    "errors": "NOT_FOUND",
    "rule": "恢復仍以 C06 為準；不得由本 API 指定舊版。"
  },
  {
    "id": "C12",
    "group": "遊戲與存檔",
    "method": "GET",
    "path": "/api/v1/jobs/{job_id}",
    "description": "輪詢長任務",
    "input": "—",
    "output": "200 Job",
    "allowed": "擁有者或管理者",
    "errors": "NOT_FOUND",
    "rule": "預設 2 秒，依 poll_after_ms 退避；不回完整 prompt。"
  },
  {
    "id": "C13",
    "group": "遊戲與存檔",
    "method": "POST",
    "path": "/api/v1/jobs/{job_id}/retry",
    "description": "重試失敗任務",
    "input": "—",
    "output": "202 AsyncReceipt",
    "allowed": "擁有者或管理者 且 FAILED retryable=true",
    "errors": "JOB_NOT_RETRYABLE",
    "rule": "同 job 的固定輸入重做；已成功的結果不可替換，不消耗重生次數；管理者重試留稽核。"
  },
  {
    "id": "D01",
    "group": "骰子與事件",
    "method": "POST",
    "path": "/api/v1/runs/{run_id}/advances",
    "description": "擲骰並開始推進",
    "input": "VersionInput",
    "output": "201 Advance",
    "allowed": "EXPLORING 且 HOME",
    "errors": "ADVANCE_EXISTS,ACTION_NOT_ALLOWED,STALE_VERSION",
    "rule": "同交易儲存骰子與行程再交 worker；不得由前端送 roll_value。"
  },
  {
    "id": "D02",
    "group": "骰子與事件",
    "method": "GET",
    "path": "/api/v1/runs/{run_id}/advances/{advance_id}",
    "description": "查詢推進進度",
    "input": "—",
    "output": "200 Advance",
    "allowed": "擁有者",
    "errors": "NOT_FOUND",
    "rule": "輪詢至暫停 完成待閱或結束；GET 不推進時間。"
  },
  {
    "id": "D03",
    "group": "骰子與事件",
    "method": "POST",
    "path": "/api/v1/runs/{run_id}/advances/{advance_id}/review",
    "description": "確認行程摘要",
    "input": "VersionInput",
    "output": "200 MutationReceipt",
    "allowed": "TURN_REVIEW",
    "errors": "STATE_CONFLICT",
    "rule": "將行程設 COMPLETED，回 EXPLORING；若 AGE_COMPLETED 已結束則直接顯示成績單。"
  },
  {
    "id": "D04",
    "group": "骰子與事件",
    "method": "GET",
    "path": "/api/v1/runs/{run_id}/events",
    "description": "已揭露事件清單",
    "input": "query: status?,kind?",
    "output": "200 Page<Event>",
    "allowed": "擁有者",
    "errors": "—",
    "rule": "只看已揭露資料；不能 enumerate 未來 ID。"
  },
  {
    "id": "D05",
    "group": "骰子與事件",
    "method": "GET",
    "path": "/api/v1/runs/{run_id}/events/{event_id}",
    "description": "事件卡與選項",
    "input": "—",
    "output": "200 Event",
    "allowed": "擁有者 且已揭露",
    "errors": "NOT_FOUND",
    "rule": "所有不可選原因可顯示，未知未來分支不回傳。"
  },
  {
    "id": "D06",
    "group": "骰子與事件",
    "method": "POST",
    "path": "/api/v1/runs/{run_id}/events/{event_id}/decisions",
    "description": "確認事件選擇",
    "input": "ChoiceInput",
    "output": "200 MutationReceipt",
    "allowed": "EVENT_PENDING",
    "errors": "CHOICE_UNAVAILABLE,EVENT_ALREADY_DECIDED",
    "rule": "選擇與結果原子儲存；需籌資轉 FUNDING，其他轉 EVENT_RESULT 或 ENDED。"
  },
  {
    "id": "D07",
    "group": "骰子與事件",
    "method": "POST",
    "path": "/api/v1/runs/{run_id}/events/{event_id}/acknowledgements",
    "description": "確認結果並繼續原骰子",
    "input": "VersionInput",
    "output": "200 MutationReceipt",
    "allowed": "EVENT_RESULT",
    "errors": "STATE_CONFLICT",
    "rule": "只是確認已決定結果；由 worker 繼續原行程，不重擲。終局不需此 API。"
  },
  {
    "id": "D08",
    "group": "骰子與事件",
    "method": "GET",
    "path": "/api/v1/runs/{run_id}/events/{event_id}/funding",
    "description": "取得籌資選項與缺口",
    "input": "—",
    "output": "200 Funding",
    "allowed": "擁有者且目前 FUNDING",
    "errors": "STATE_CONFLICT",
    "rule": "反映所有可行來源和申請理賠，不可直接現金不足判死。"
  },
  {
    "id": "D09",
    "group": "骰子與事件",
    "method": "POST",
    "path": "/api/v1/runs/{run_id}/events/{event_id}/funding/pay",
    "description": "完成必要治療付款",
    "input": "VersionInput",
    "output": "200 MutationReceipt",
    "allowed": "FUNDING 且 can_pay=true",
    "errors": "INSUFFICIENT_FUNDS",
    "rule": "現金與活存按明定順序扣款；全額支付一次完成，轉 EVENT_RESULT。"
  },
  {
    "id": "D10",
    "group": "骰子與事件",
    "method": "POST",
    "path": "/api/v1/runs/{run_id}/events/{event_id}/funding/wait",
    "description": "等待已知款項或期限",
    "input": "VersionInput",
    "output": "200 MutationReceipt",
    "allowed": "FUNDING 且 can_wait=true",
    "errors": "WAIT_NOT_AVAILABLE",
    "rule": "後端決定下一入帳日或期限；處理期間全部到期專案，不可送任意日期。"
  },
  {
    "id": "D11",
    "group": "骰子與事件",
    "method": "POST",
    "path": "/api/v1/runs/{run_id}/events/{event_id}/funding/confirm-failure",
    "description": "確認無法籌足款項",
    "input": "VersionInput",
    "output": "200 MutationReceipt",
    "allowed": "FUNDING 且 can_confirm_failure=true",
    "errors": "FUNDING_AVAILABLE",
    "rule": "結束為 UNFUNDED_CRITICAL_CARE；若還有能成功救援的組合則拒絕。"
  },
  {
    "id": "D12",
    "group": "骰子與事件",
    "method": "GET",
    "path": "/api/v1/runs/{run_id}/timeline",
